#!/usr/bin/env bash
set -euo pipefail
mem_available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
mem_total_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
[[ -n "$mem_available_kb" && -n "$mem_total_kb" && "$mem_total_kb" -gt 0 ]] || exit 0
percent=$(( mem_available_kb * 100 / mem_total_kb ))
# Never touch page cache during normal memory conditions.
if (( percent < 12 )); then
  sync
  printf 1 > /proc/sys/vm/drop_caches
fi
